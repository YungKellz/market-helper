{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Caption Craft",
  "version": "0.2.0",
  "identifier": "ru.captioncraft.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Caption Craft",
        "width": 1180,
        "height": 820,
        "minWidth": 940,
        "minHeight": 640,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Andrey Nazarenko",
    "shortDescription": "Продающие описания для Авито",
    "longDescription": "Определяет товар по фото и генерирует продающее описание карточки Авито локальной ИИ-моделью.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Russian"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFNDBCQjYyNTJBMEY2MjUKUldRbDlxQlNZcnRBUG9HVGRkV1kxY295UE1mWlE0WTFwQWM2a0NrdjZOb2o5d0VNeUNUR3YvMXAK",
      "endpoints": [
        "https://github.com/YungKellz/market-helper/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
